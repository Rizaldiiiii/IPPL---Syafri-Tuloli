# Salin file ini menjadi `.env` di root repository, lalu isi nilainya.
# JANGAN commit file `.env`.

# Path file SQLite, relatif terhadap server/prisma/schema.prisma
DATABASE_URL=file:./dev.db

# Wajib diisi. Gunakan string acak yang panjang (contoh cara membuat:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=ganti-dengan-string-acak-panjang

# Port REST API
PORT=3001

# Umur token JWT
JWT_EXPIRES_IN=7d
