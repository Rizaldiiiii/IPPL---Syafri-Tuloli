{
  "name": "@gantt/client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Antarmuka React untuk aplikasi manajemen proyek Gantt Chart",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
